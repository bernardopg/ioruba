{
  "name": "@ioruba/desktop",
  "version": "1.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "desktop:watch": "tauri dev",
    "build": "tsc --project tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
